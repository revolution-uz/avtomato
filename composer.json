{
    "name": "avtomato/app",
    "type": "project",
    "description": "Business automation system",
    "keywords": ["avtomato", "crm", "automation"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "chinleung/laravel-multilingual-routes": "^4.1.1",
        "guzzlehttp/guzzle": "^7.9.2",
        "laravel/framework": "^11.17",
        "laravel/horizon": "^5.26",
        "laravel/nova": "^5.0",
        "laravel/sanctum": "^4.0.2",
        "opcodesio/log-viewer": "^3.10",
        "phpoffice/phpword": "^1.2",
        "rebing/graphql-laravel": "^9.5",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-data": "^4.7",
        "stancl/tenancy": "^3.8",
        "avtomato/transaction-by-companies": "@dev"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.13",
        "captainhook/captainhook": "*",
        "fakerphp/faker": "^1.23.1",
        "larastan/larastan": "^2.9.8",
        "laravel/tinker": "^2.9",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.3",
        "phpunit/phpunit": "^11.2.8",
        "spatie/laravel-ignition": "^2.8",
        "tightenco/duster": "^3.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "[ $COMPOSER_DEV_MODE -eq 0 ] || vendor/bin/captainhook install -f -s"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall",
            "@php artisan nova:publish",
            "@php artisan horizon:publish --ansi",
            "@php artisan log-viewer:publish"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan nova:publish",
            "@php artisan horizon:publish --ansi",
            "@php artisan log-viewer:publish"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "hooks": {
            "pre-push": [
                "./vendor/bin/duster lint"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "nova": {
            "type": "composer",
            "url": "https://nova.laravel.com"
        },
        "0": {
            "type": "path",
            "url": "./nova-components/TransactionByCompanies"
        }
    }
}
