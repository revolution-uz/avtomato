{
    "name": "avtomato/app",
    "type": "project",
    "description": "Business automation system",
    "keywords": ["avtomato", "crm", "automation"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "chinleung/laravel-multilingual-routes": "^4.1.1",
        "darkaonline/l5-swagger": "^8.6.0",
        "guzzlehttp/guzzle": "^7.8.1",
        "laravel/framework": "^11.13",
        "laravel/horizon": "^5.24.5",
        "laravel/nova": "^4.33.3",
        "laravel/sanctum": "^4.0.2",
        "opcodesio/log-viewer": "^3.10.1",
        "rebing/graphql-laravel": "^9.5",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-data": "^4.7.1",
        "stancl/tenancy": "^3.8.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.13.5",
        "captainhook/captainhook": "*",
        "fakerphp/faker": "^1.23.1",
        "larastan/larastan": "^2.9.7",
        "laravel/tinker": "^2.9",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.1.1",
        "phpunit/phpunit": "^11.2.5",
        "spatie/laravel-ignition": "^2.8.0",
        "tightenco/duster": "^3.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "cghooks": "vendor/bin/cghooks",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "dev-post-install-cmd": [
            "cghooks add --ignore-lock"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "cghooks update"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "hooks": {
            "pre-push": [
                "./vendor/bin/duster lint"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "nova": {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    }
}
